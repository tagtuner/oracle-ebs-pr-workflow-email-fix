# Copy to .env and fill in real values locally — never commit .env

# Database (dummy placeholders)
EBS_DB_DSN=ebs-db.example.local:1521/PROD
APPS_USER=APPS
APPS_PWD=your-apps-password-here

# Apps tier SSH (OACore bounce + WFMLRSVC / mailer JVM)
PROD_APPS_SSH=oracle@ebs-apps.example.local
EBS_APPS_ENV=/u01/oracle/EBS/R12211/EBSapps.env
WEBLOGIC_ADMIN_PASSWORD=your-weblogic-password-here
HTMLAGENT=http://ebs-apps.example.local:8000/

# Oracle Instant Client (Windows example)
ORACLE_CLIENT_LIB=C:\oracle\instantclient_21_3

# Workflow Notification Mailer
WFMLR_QUEUE_ID=1140
WF_MAILER_COMPONENT_ID=10006

# SMTP mailbox used by the mailer (dummy)
MAIL_HOST=mail.example.com
MAIL_USER=workflow.mailer@example.com
MAIL_PWD=your-mailbox-password-here
MAILER_SSL_TRUSTSTORE=/u01/oracle/EBS/fs2/EBSapps/comn/util/jdk64/jre/lib/security/cacerts

# Optional: monitor / mark-error scripts
MONITOR_SINCE=2026-08-25 16:21:00
POISON_NOTIFICATION_ID=2103324
